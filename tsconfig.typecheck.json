{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "mcp-server/**/*.ts",
    "hardhat.config.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "scripts/generate-frontend-snapshot.ts"
  ]
}