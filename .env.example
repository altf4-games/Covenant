# Copy this to .env and fill in real values. .env is gitignored - never commit it.

# --- Currently used by code ---

# hardhat.config.ts: overrides the default BSC RPC used for the bscFork network.
# Default (if unset) is https://bsc-mainnet.public.blastapi.io - see
# docs/partner-feedback/friction-log.md B12 for why that one specifically.
BSC_RPC_URL=

# scripts/oracle-updater.ts: the deployed Covenant contract to push oracle updates to. Required.
COVENANT_ADDRESS=

# scripts/oracle-updater.ts: optional overrides. Default token is real NVDAB
# (docs/research/verified-facts.md), default chain is 56 (BSC).
ORACLE_TOKEN_ADDRESS=
ORACLE_BINANCE_CHAIN_ID=

# --- Reserved, not consumed by any script yet ---

# Binance Web3 API key/secret (developer portal: https://web3.binance.com/en/dev-portal).
# Not required for anything built so far - the oracle updater's halt/status
# data comes from a public, unauthenticated endpoint (see
# docs/partner-feedback/friction-log.md B15). Only needed if a later phase
# adds Trading API quotes, Wallet API balance checks, or other HMAC-signed
# Web3 API calls (strategy-report.md §2.4's full sponsor-stack table).
WEB3_API_KEY=
WEB3_API_SECRET=
