# Copy this to .env and fill in real values. .env is gitignored - never commit it.

# --- RPC ---

# Overrides the RPC. Leave blank for the defaults: the mainnet scripts (deploy,
# oracle updater, ERC-8004) use several free endpoints behind a fallback
# provider, so one rate-limiting doesn't stop the unattended oracle updater. The
# local fork (`bscFork`, used by the tests) still needs an endpoint that serves
# historical state, which today means https://bsc-mainnet.public.blastapi.io -
# see docs/partner-feedback/friction-log.md B12 and B19.
BSC_RPC_URL=

# --- The three roles. Covenant v2 rejects any two being the same key. ---

# Owner. scripts/deploy.ts deploys and configures with this key; it also
# backs hardhat.config.ts's `bsc` network. NEVER commit a filled-in value.
DEPLOYER_PRIVATE_KEY=

# Oracle updater. scripts/deploy.ts needs the address; scripts/oracle-updater.ts
# signs with the key. Must differ from the owner and the agent.
ORACLE_UPDATER_ADDRESS=
ORACLE_UPDATER_PRIVATE_KEY=

# Agent: the Binance Agentic Wallet's BSC address. It signs commit/settle
# through `baw contract-call`, so no private key lives here.
AGENT_ADDRESS=

# --- Deployed contract ---

# Read by scripts/oracle-updater.ts, scripts/judge.ts and scripts/verify.ts.
COVENANT_ADDRESS=

# --- scripts/deploy.ts mandate settings (all optional, human units) ---

MANDATE_TOKEN_ADDRESS=
MANDATE_MAX_NOTIONAL_USD=
MANDATE_MAX_TRADES_PER_DAY=
# Red-team fix H7: a separate cumulative cap, independent of the per-trade
# cap x trades-per-day. Unset or "0" leaves it disabled.
MANDATE_MAX_DAILY_NOTIONAL_USD=
MANDATE_DURATION_DAYS=
TOKEN_MAX_SLIPPAGE_BPS=
TOKEN_MAX_POSITION_USD=
TOKEN_MAX_CLOSED_MARKET_DRIFT_BPS=
ORACLE_STALENESS_SECONDS=
DECISION_TTL_SECONDS=

# --- scripts/oracle-updater.ts overrides (optional) ---

# Default token is real NVDAB (docs/research/verified-facts.md), default chain 56.
ORACLE_TOKEN_ADDRESS=
ORACLE_BINANCE_CHAIN_ID=
# Which authenticated listing to check ORACLE_TOKEN_ADDRESS against (red-team
# fix H10). Default "bstock".
ORACLE_PLATFORM_ID=

# --- Verification ---

# Verifies deployed contracts on BscScan via Etherscan's unified API V2 -
# one key covers BSC and 60+ other EVM chains. Free, from etherscan.io/myapikey.
ETHERSCAN_API_KEY=

# --- Binance Web3 API (HMAC-signed modules) ---

# Developer portal: https://web3.binance.com/en/dev-portal. The oracle's
# price/status feed still comes from public bapi endpoints (friction-log.md
# B15), but scripts/oracle-updater.ts now REQUIRES these too: before posting
# any price it cross-checks the token address against Binance's
# authenticated Market API (scripts/lib/web3-api-client.ts, red-team fix
# H10) and fails closed if either the credentials or the listing are
# missing.
WEB3_API_KEY=
WEB3_API_SECRET=

# Optional: scripts/generate-narration.ts writes one play-by-play line per real
# decision into frontend/src/data/narration.json. Free key from
# https://aistudio.google.com/apikey. Only the script uses it; it never
# reaches the browser.
GEMINI_API_KEY=
